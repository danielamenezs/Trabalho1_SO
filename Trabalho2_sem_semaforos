#include <stdio.h>      // biblioteca usada para funções de entrada e saída, como printf
#include <pthread.h>    // biblioteca usada para trabalhar com threads
#include <stdlib.h>     // biblioteca usada para rand e outras funções gerais
#include <unistd.h>     // biblioteca usada para a função sleep

#define BUFFER_SIZE 5   // define o tamanho máximo do buffer

// vetor que representa o buffer compartilhado entre produtor e consumidor
int buffer[BUFFER_SIZE];

// variável in indica a próxima posição onde o produtor vai inserir um item
// variável out indica a próxima posição de onde o consumidor vai retirar um item
// variável count guarda quantos itens existem atualmente no buffer
int in = 0, out = 0, count = 0;

// mutex usado para garantir que só uma thread acesse o buffer por vez
pthread_mutex_t mutex;

// variável de condição usada para avisar quando o buffer não está cheio
pthread_cond_t not_full;

// variável de condição usada para avisar quando o buffer não está vazio
pthread_cond_t not_empty;

// função executada pela thread produtora
void* producer(void* arg) {
    // loop infinito para o produtor continuar produzindo itens
    while (1) {

        // gera um item aleatório entre 0 e 99
        // isso simula a produção de um dado
        int item = rand() % 100;

        // trava o mutex antes de acessar o buffer
        // isso marca a entrada na região crítica
        pthread_mutex_lock(&mutex);

        // enquanto o buffer estiver cheio, o produtor deve esperar
        // BUFFER_SIZE é o tamanho máximo do buffer
        while (count == BUFFER_SIZE)
            // a thread produtora dorme esperando o sinal de que surgiu espaço no buffer
            // enquanto espera, ela libera temporariamente o mutex
            // quando acorda, ela pega o mutex de novo antes de continuar
            pthread_cond_wait(&not_full, &mutex);

        // insere o item produzido na posição indicada por in
        buffer[in] = item;

        // mostra na tela o item produzido e a posição onde ele foi inserido
        printf("Produced: %d at %d\n", item, in);

        // atualiza o índice de inserção
        // o operador % BUFFER_SIZE faz o índice voltar para 0 ao chegar no fim do buffer
        // isso transforma o vetor em um buffer circular
        in = (in + 1) % BUFFER_SIZE;

        // aumenta a quantidade de itens no buffer
        count++;

        // avisa que o buffer agora possui pelo menos um item disponível
        // isso pode acordar uma thread consumidora que estava esperando
        pthread_cond_signal(&not_empty);

        // libera o mutex, saindo da região crítica
        pthread_mutex_unlock(&mutex);

        // pausa por 1 segundo para simular o tempo de produção
        sleep(1);
    }

    // retorno da função da thread
    // na prática, essa linha não é alcançada por causa do loop infinito
    return NULL;
}

// função executada pela thread consumidora
void* consumer(void* arg) {
    // loop infinito para o consumidor continuar consumindo itens
    while (1) {

        // trava o mutex antes de acessar o buffer
        // isso garante acesso exclusivo à região crítica
        pthread_mutex_lock(&mutex);

        // enquanto o buffer estiver vazio, o consumidor deve esperar
        while (count == 0)
            // a thread consumidora dorme esperando o sinal de que surgiu item no buffer
            // enquanto espera, ela libera temporariamente o mutex
            // quando acorda, pega o mutex novamente antes de continuar
            pthread_cond_wait(&not_empty, &mutex);

        // retira o item da posição indicada por out
        int item = buffer[out];

        // mostra na tela o item consumido e a posição de onde ele foi retirado
        printf("Consumed: %d at %d\n", item, out);

        // atualiza o índice de remoção
        // o operador % BUFFER_SIZE faz o índice voltar para 0 ao chegar no fim do buffer
        // assim, o buffer também funciona de forma circular para o consumidor
        out = (out + 1) % BUFFER_SIZE;

        // diminui a quantidade de itens no buffer
        count--;

        // avisa que agora existe pelo menos uma posição livre no buffer
        // isso pode acordar uma thread produtora que estava esperando
        pthread_cond_signal(&not_full);

        // libera o mutex, saindo da região crítica
        pthread_mutex_unlock(&mutex);

        // pausa por 1 segundo para simular o tempo de consumo
        sleep(1);
    }

    // retorno da função da thread
    // na prática, essa linha não é alcançada por causa do loop infinito
    return NULL;
}

int main() {
    // declara as duas threads: uma produtora e uma consumidora
    pthread_t prod, cons;

    // inicializa o mutex
    // o segundo argumento NULL indica que serão usados os atributos padrão
    pthread_mutex_init(&mutex, NULL);

    // inicializa a variável de condição not_full
    // ela será usada quando o produtor precisar esperar espaço no buffer
    pthread_cond_init(&not_full, NULL);

    // inicializa a variável de condição not_empty
    // ela será usada quando o consumidor precisar esperar item no buffer
    pthread_cond_init(&not_empty, NULL);

    // cria a thread produtora
    // ela irá executar a função producer
    pthread_create(&prod, NULL, producer, NULL);

    // cria a thread consumidora
    // ela irá executar a função consumer
    pthread_create(&cons, NULL, consumer, NULL);

    // espera a thread produtora terminar
    // como a função producer tem loop infinito, normalmente ela nunca termina
    pthread_join(prod, NULL);

    // espera a thread consumidora terminar
    // como a função consumer também tem loop infinito, normalmente ela nunca termina
    pthread_join(cons, NULL);

    // destrói o mutex
    // em uma execução normal, essa linha quase nunca será alcançada por causa dos loops infinitos
    pthread_mutex_destroy(&mutex);

    // destrói a variável de condição not_full
    pthread_cond_destroy(&not_full);

    // destrói a variável de condição not_empty
    pthread_cond_destroy(&not_empty);

    // encerra o programa
    return 0;
}
