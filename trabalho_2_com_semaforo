/*
O problema do produtor e consumidor, também conhecido como problema do buffer limitado,
consiste em processos ou threads que compartilham um mesmo buffer.

Os produtores colocam informações no buffer, enquanto os consumidores retiram essas
informações. O problema acontece porque o produtor não pode inserir dados quando o
buffer está cheio, e o consumidor não pode retirar dados quando o buffer está vazio.

Por isso, é necessário usar mecanismos de sincronização, como semáforos e mutex,
para controlar o acesso ao buffer e evitar condições de corrida.
*/

#include <stdio.h>      // biblioteca usada para entrada e saída, como printf
#include <stdlib.h>     // biblioteca usada para malloc, rand e exit
#include <pthread.h>    // biblioteca usada para trabalhar com threads
#include <unistd.h>     // biblioteca usada para a função sleep
#include <semaphore.h>  // biblioteca usada para trabalhar com semáforos

#define PR 1    // quantidade de produtores
#define CN 1    // quantidade de consumidores
#define N 5     // tamanho do buffer

// declaração das funções que serão executadas pelas threads
void *produtor(void *meuid);
void *consumidor(void *meuid);

// semáforo que controla quantas posições livres existem no buffer
sem_t empty;

// semáforo que controla quantas posições ocupadas existem no buffer
sem_t full;

// mutex usado para garantir que apenas uma thread acesse o buffer por vez
pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;

// índice onde o produtor irá inserir o próximo item
int index_in = 0;

// índice de onde o consumidor irá retirar o próximo item
int index_out = 0;

// vetor que representa o buffer compartilhado entre produtor e consumidor
int buffer[N] = {0};

void main(argc, argv)
int argc;
char *argv[];
{
  int erro;       // variável usada para verificar se houve erro na criação das threads
  int i, n, m;    // variáveis auxiliares
  int *id;        // ponteiro usado para guardar o id de cada thread

  // inicializa o semáforo empty com o valor N,
  // pois no começo todas as posições do buffer estão vazias
  sem_init(&empty, 0, N);

  // inicializa o semáforo full com o valor 0,
  // pois no começo não existe nenhum item no buffer
  sem_init(&full, 0, 0);

  printf("BUFFER INICIALIZADO!\n");

  // vetor que armazena as threads produtoras
  pthread_t tPid[PR];

  // laço responsável por criar as threads produtoras
  for (i = 0; i < PR; i++) {
    // aloca memória para armazenar o id da thread
    id = (int *)malloc(sizeof(int));

    // atribui o número i como identificador da thread
    *id = i;

    // cria uma thread produtora, que irá executar a função produtor
    erro = pthread_create(&tPid[i], NULL, produtor, (void *)(id));

    // se pthread_create retornar erro, o programa exibe mensagem e encerra
    if (erro) {
      printf("erro na criacao do thread %d\n", i);
      exit(1);
    }
  }

  // vetor que armazena as threads consumidoras
  pthread_t tCid[CN];

  // laço responsável por criar as threads consumidoras
  for (i = 0; i < CN; i++) {
    // aloca memória para armazenar o id da thread
    id = (int *)malloc(sizeof(int));

    // atribui o número i como identificador da thread
    *id = i;

    // cria uma thread consumidora, que irá executar a função consumidor
    erro = pthread_create(&tCid[i], NULL, consumidor, (void *)(id));

    // se pthread_create retornar erro, o programa exibe mensagem e encerra
    if (erro) {
      printf("erro na criacao do thread %d\n", i);
      exit(1);
    }
  }

  // destrói o semáforo de posições livres
  sem_destroy(&empty);

  // destrói o semáforo de posições ocupadas
  sem_destroy(&full);

  // espera a thread produtora terminar
  // como o produtor está em loop infinito, na prática o programa continua executando
  pthread_join(tPid[0], NULL);
}

// função executada pela thread produtora
void *produtor(void *pi) {
  int item, value;

  // loop infinito para o produtor continuar produzindo itens
  while (1) {
    // gera um item aleatório entre 0 e 4
    item = rand() % 5;

    // decrementa o semáforo empty
    // se não houver posição livre, o produtor fica bloqueado esperando
    sem_wait(&empty);

      // trava o mutex para entrar na região crítica
      // isso impede que outra thread mexa no buffer ao mesmo tempo
      pthread_mutex_lock(&mutex);

        // insere o item produzido na posição atual do buffer
        buffer[index_in] = item;

        // mostra na tela qual item foi inserido e em qual posição
        printf("Produtor   está inserindo o item %d no buffer[%d]\n", item, index_in);

        // atualiza o índice de inserção
        // o operador % N faz o índice voltar para 0 quando chega no fim do buffer
        index_in = (index_in + 1) % N;

      // libera o mutex, saindo da região crítica
      pthread_mutex_unlock(&mutex);

    // incrementa o semáforo full
    // isso indica que agora existe mais uma posição ocupada no buffer
    sem_post(&full);

    // pega o valor atual do semáforo full
    sem_getvalue(&full, &value);

    // se full for igual ao tamanho do buffer, significa que o buffer está cheio
    if (value == N) {
      printf("BUFFER CHEIO!\n");
    }

    // faz a thread dormir por um tempo aleatório entre 0 e 2 segundos
    // isso simula o tempo de produção
    sleep(rand() % 3);
  }

  // encerra a thread, embora essa linha praticamente não seja alcançada por causa do loop infinito
  pthread_exit(0);
}

// função executada pela thread consumidora
void *consumidor(void *pi) {
  int item, value;

  // loop infinito para o consumidor continuar consumindo itens
  while (1) {

    // decrementa o semáforo full
    // se não houver item no buffer, o consumidor fica bloqueado esperando
    sem_wait(&full);

      // trava o mutex para entrar na região crítica
      // isso garante acesso exclusivo ao buffer
      pthread_mutex_lock(&mutex);

        // retira o item da posição atual do buffer
        item = buffer[index_out];

        // mostra na tela qual item foi removido e de qual posição
        printf("Consumidor está removendo o item %d do buffer[%d]\n", item, index_out);

        // atualiza o índice de remoção
        // o operador % N faz o índice voltar para 0 quando chega no fim do buffer
        index_out = (index_out + 1) % N;

      // libera o mutex, saindo da região crítica
      pthread_mutex_unlock(&mutex);

    // incrementa o semáforo empty
    // isso indica que agora existe mais uma posição livre no buffer
    sem_post(&empty);

    // pega o valor atual do semáforo full
    sem_getvalue(&full, &value);

    // se full for 0, significa que não há itens no buffer
    if (value == 0) {
      printf("BUFFER VAZIO!\n");
    }

    // faz a thread dormir por um tempo aleatório entre 0 e 5 segundos
    // isso simula o tempo de consumo
    sleep(rand() % 6);
  }

  // encerra a thread, embora essa linha praticamente não seja alcançada por causa do loop infinito
  pthread_exit(0);
}
